# =======================================================
# AI Marketing Mix & Incrementality Copilot — Environment
# =======================================================

# Set to true to run deterministic, rule-based reasoning and precomputed Bayesian models with ZERO API costs.
DEMO_MODE=true

# Environment: development, staging, production
ENVIRONMENT=development

# Database URL (SQLite default requires zero external setup)
DATABASE_URL=sqlite:///./copilot.db

# Server Port
PORT=8000

# Optional: LLM Provider Keys (Only needed if DEMO_MODE=false)
OPENAI_API_KEY=
GEMINI_API_KEY=
